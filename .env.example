# Copy this file to .env and fill in real values. Never commit .env itself.

ASPNETCORE_ENVIRONMENT=Development

POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=

RABBITMQ_USER=nexora
RABBITMQ_PASSWORD=

# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=

WEB_ORIGIN=http://localhost:3000

# --- Local node (a second, genuinely separate deployment - see docs/sync.md) ---
NODE_POSTGRES_DB=nexora_node
NODE_POSTGRES_USER=nexora
NODE_POSTGRES_PASSWORD=

# The node's own JWT signing key - independent of the cloud's. Each
# deployment has its own Users table and issues/validates its own tokens.
NODE_JWT_SIGNING_KEY=

# Leave blank until you've registered the node: call
# POST /api/v1/sync/nodes against the running cloud API (as an
# authenticated org admin), then fill these in from the response and
# restart the local-node container.
NODE_ID=
NODE_SECRET=
